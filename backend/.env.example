# backend/.env — vms/backend, hosted Supabase Cloud project
#
# Copy this file to backend/.env and fill in real values. backend/.env is
# git-ignored (see repo root .gitignore) — never commit real secrets.
#
# This project must be a SEPARATE Supabase project from platform's — see
# platform-design.md §2 ("Module = separate project"). Do not point this at
# the same project as tmp-partner-admin/.env.

# --- Supabase Cloud project (Settings > API in the Supabase dashboard) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct Postgres connection (Settings > Database > Connection string,
# "URI" format) — used to run pgTAP test files directly via psql, since
# there's no local Docker stack to run `supabase test db` against. ---
SUPABASE_DB_URL=

# --- Supabase CLI auth, for `supabase link` / `supabase db push` against
# this hosted project instead of a local one ---
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Shared cross-project secret ---
# MUST be the exact same value as STAFF_JWT_SECRET in
# tmp-partner-admin/.env — platform mints staff tokens with this secret,
# vms/backend's verifyStaffToken() verifies them with it. A mismatch fails
# every staff-authenticated call silently until checked (vms-backend plan
# post-plan checklist already flags this).
STAFF_JWT_SECRET=

# --- Cloudflare R2 (CNIC documents, profile pictures — spec §6) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_URL=

# --- Resend (transactional email — spec §6) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
